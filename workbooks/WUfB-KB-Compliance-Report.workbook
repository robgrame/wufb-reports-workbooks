            "multiSelect": true,
            "quote": "\"",
            "delimiter": ",",
            "query": "UCClientUpdateStatus\n| where UpdateCategory == \"WindowsQualityUpdate\"\n| where isnotempty(UpdateReleaseTime)\n| extend CUMonth = format_datetime(UpdateReleaseTime, \"yyyy-MM\")\n| distinct CUMonth\n| order by CUMonth desc",
            "timeContext": {
              "durationMs": 0
