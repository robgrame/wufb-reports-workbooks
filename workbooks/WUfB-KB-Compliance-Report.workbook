{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# 📈 WUfB Reports - Riepilogo Compliance per KB\n\nReport focalizzato sulla compliance di installazione per ciascuna KB, con indicazione del mese di riferimento della Cumulative Update.\n\n> **Filtro Tipo PC:** di default i report mostrano solo i **PC Modern** (Windows 11; esclusi i Windows 10). Imposta *Tipo PC = Tutti i PC* per includere anche i Windows 10.\n\n---"
      },
      "name": "text-header"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "c1a1e001-1111-4a1a-b1c1-111111111111",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "type": 4,
            "isRequired": true,
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2592000000
                },
                {
                  "durationMs": 7776000000
                }
              ],
              "allowCustom": true
            },
            "value": {
              "durationMs": 2592000000
            },
            "label": "Intervallo Temporale"
          },
          {
            "id": "c1a1e001-2222-4a1a-b1c1-222222222222",
            "version": "KqlParameterItem/1.0",
            "name": "KBFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "UCClientUpdateStatus\n| where TimeGenerated > ago(90d)\n| where UpdateCategory == 'WindowsQualityUpdate'\n| distinct TargetKBNumber\n| where isnotempty(TargetKBNumber)\n| order by TargetKBNumber desc",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*"
            },
            "defaultValue": "value::all",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "label": "KB Number"
          },
          {
            "id": "c1a1e001-3333-4a1a-b1c1-333333333333",
            "version": "KqlParameterItem/1.0",
            "name": "ClientStateFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "UCClientUpdateStatus\n| where TimeGenerated > ago(90d)\n| where UpdateCategory == 'WindowsQualityUpdate'\n| distinct ClientState\n| order by ClientState asc",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*"
            },
            "defaultValue": "value::all",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "label": "Client State"
          },
          {
            "id": "c1a1e001-4444-4a1a-b1c1-444444444444",
            "version": "KqlParameterItem/1.0",
            "name": "UpdateClassificationFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "UCClientUpdateStatus\n| where TimeGenerated > ago(90d)\n| where UpdateCategory == 'WindowsQualityUpdate'\n| distinct UpdateClassification\n| order by UpdateClassification asc",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*"
            },
            "defaultValue": "value::all",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "label": "Classification (Security/NonSecurity)"
          },
          {
            "id": "c1a1e001-6666-4a1a-b1c1-666666666666",
            "version": "KqlParameterItem/1.0",
            "name": "CUMonthFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "UCClientUpdateStatus\n| where TimeGenerated > ago(90d)\n| where UpdateCategory == 'WindowsQualityUpdate'\n| where isnotempty(UpdateReleaseTime)\n| extend CUMonth = format_datetime(UpdateReleaseTime, 'yyyy-MM')\n| distinct CUMonth\n| order by CUMonth desc",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*"
            },
            "defaultValue": "value::all",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "label": "CU Month"
          },
          {
            "id": "c1a1e001-7777-4a1a-b1c1-777777777777",
            "version": "KqlParameterItem/1.0",
            "name": "OSVersionFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "UCClient\n| where TimeGenerated {TimeRange}\n| summarize arg_max(TimeGenerated, *) by AzureADDeviceId\n| distinct OSVersion\n| where isnotempty(OSVersion)\n| order by OSVersion desc",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*"
            },
            "defaultValue": "value::all",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "label": "OS Version"
          },
          {
            "id": "c1a1e001-9999-4a1a-b1c1-999999999999",
            "version": "KqlParameterItem/1.0",
            "name": "ModernOnly",
            "type": 2,
            "isRequired": true,
            "typeSettings": {
              "additionalResourceOptions": []
            },
            "jsonData": "[\n  { \"value\": \"modern\", \"label\": \"Solo PC Modern (esclude Windows 10)\", \"selected\": true },\n  { \"value\": \"all\", \"label\": \"Tutti i PC\" }\n]",
            "queryType": 8,
            "label": "Tipo PC"
          },
          {
            "id": "c1a1e001-5555-4a1a-b1c1-555555555555",
            "version": "KqlParameterItem/1.0",
            "name": "DeviceNameFilter",
            "type": 1,
            "isRequired": false,
            "value": "",
            "label": "Filtro Device Name (contiene)"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "parameters"
    },
    {
      "type": 1,
      "content": {
        "json": "## 📊 Compliance per KB - Riepilogo\n\n**Legenda ClientState** (stato lato device, fonte `UCClientUpdateStatus`):\n\n| Stato | Significato |\n|---|---|\n| 🟢 **Installed** | La KB è installata sul device. |\n| 🔵 **Installing** | Il device ha iniziato il workflow di installazione (download, install, restart pending). Vedi `ClientSubstate` per il dettaglio (es. `DownloadStart`, `InstallStart`, `RestartRequired`). |\n| 🟠 **Offering** | La KB è stata *offerta* al device (visibile in Windows Update) ma l'installazione non è ancora iniziata. Tipico quando il device non si è ancora collegato/non ha ancora avviato il download, o è in attesa di una *active hour* / deadline. |\n| 🟡 **OnHold** | Installazione bloccata da una *safeguard hold* di Microsoft (incompatibilità nota), da una *pause* configurata nel Ring, o da una deferral policy. Il device riceverà la KB quando l'hold sarà rimosso. |\n| ⚪ **Canceled** | L'offerta è stata annullata (es. policy cambiata, KB superata da una più recente, deployment annullato). |\n| ❔ **Unknown** | Il device non ha ancora riportato un ClientState per quella KB (tipicamente perché non l'ha ancora ricevuta o non ha completato lo scan). Se persiste indica un problema di reporting/diagnostica."
      },
      "name": "text-section-summary"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let _kb = dynamic([{KBFilter}]);\nlet _clientState = dynamic([{ClientStateFilter}]);\nlet _classification = dynamic([{UpdateClassificationFilter}]);\nlet _cuMonth = dynamic([{CUMonthFilter}]);\nlet _osVersion = dynamic([{OSVersionFilter}]);\nlet _modernOnly = \"{ModernOnly}\";\nlet _deviceFilter = \"{DeviceNameFilter}\";\nlet clientInfo = UCClient\n| where TimeGenerated {TimeRange}\n| summarize arg_max(TimeGenerated, *) by AzureADDeviceId\n| project AzureADDeviceId, OSVersion;\nUCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"WindowsQualityUpdate\"\n| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)\n| where \"*\" in (_kb) or TargetKBNumber in (_kb)\n| where \"*\" in (_classification) or UpdateClassification in (_classification)\n| where _deviceFilter == \"\" or DeviceName contains _deviceFilter\n| summarize arg_max(TimeGenerated, *) by DeviceName, TargetKBNumber\n| where \"*\" in (_clientState) or ClientState in (_clientState)\n| extend CUMonth = format_datetime(UpdateReleaseTime, \"yyyy-MM\")\n| where \"*\" in (_cuMonth) or CUMonth in (_cuMonth)\n| join kind=leftouter clientInfo on AzureADDeviceId\n| where \"*\" in (_osVersion) or OSVersion in (_osVersion)\n| where _modernOnly == \"all\" or not(OSVersion startswith \"Windows 10\")\n| summarize\n    TotalDevices = dcount(DeviceName),\n    Installed = dcountif(DeviceName, ClientState == \"Installed\"),\n    Installing = dcountif(DeviceName, ClientState == \"Installing\"),\n    Offering = dcountif(DeviceName, ClientState == \"Offering\"),\n    OnHold = dcountif(DeviceName, ClientState == \"OnHold\"),\n    Canceled = dcountif(DeviceName, ClientState == \"Canceled\"),\n    Unknown = dcountif(DeviceName, ClientState == \"Unknown\")\n    by TargetKBNumber, UpdateDisplayName, UpdateClassification, CUMonth\n| extend PercentInstalled = round(todouble(Installed) / todouble(TotalDevices) * 100, 1)\n| project\n    CUMonth,\n    TargetKBNumber,\n    UpdateDisplayName,\n    UpdateClassification,\n    TotalDevices,\n    Installed,\n    Installing,\n    Offering,\n    OnHold,\n    Canceled,\n    Unknown,\n    PercentInstalled\n| order by CUMonth desc, TargetKBNumber desc",
        "size": 0,
        "title": "Compliance per KB con mese CU di riferimento",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "PercentInstalled",
              "formatter": 8,
              "formatOptions": {
                "min": 0,
                "max": 100,
                "palette": "redGreen"
              }
            },
            {
              "columnMatch": "Installed",
              "formatter": 8,
              "formatOptions": {
                "palette": "green"
              }
            },
            {
              "columnMatch": "Unknown",
              "formatter": 8,
              "formatOptions": {
                "palette": "gray"
              }
            },
            {
              "columnMatch": "UpdateClassification",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Security",
                    "representation": "3",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "NonSecurity",
                    "representation": "1",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "filter": true,
          "sortBy": [
            {
              "itemKey": "CUMonth",
              "sortOrder": 2
            }
          ]
        }
      },
      "name": "grid-kb-compliance-summary"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let _kb = dynamic([{KBFilter}]);\nlet _classification = dynamic([{UpdateClassificationFilter}]);\nlet _cuMonth = dynamic([{CUMonthFilter}]);\nlet _osVersion = dynamic([{OSVersionFilter}]);\nlet _modernOnly = \"{ModernOnly}\";\nlet _deviceFilter = \"{DeviceNameFilter}\";\nlet clientInfo = UCClient\n| where TimeGenerated {TimeRange}\n| summarize arg_max(TimeGenerated, *) by AzureADDeviceId\n| project AzureADDeviceId, OSVersion;\nUCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"WindowsQualityUpdate\"\n| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)\n| where \"*\" in (_kb) or TargetKBNumber in (_kb)\n| where \"*\" in (_classification) or UpdateClassification in (_classification)\n| where _deviceFilter == \"\" or DeviceName contains _deviceFilter\n| summarize arg_max(TimeGenerated, *) by DeviceName, TargetKBNumber\n| extend CUMonth = format_datetime(UpdateReleaseTime, \"yyyy-MM\")\n| where \"*\" in (_cuMonth) or CUMonth in (_cuMonth)\n| join kind=leftouter clientInfo on AzureADDeviceId\n| where \"*\" in (_osVersion) or OSVersion in (_osVersion)\n| where _modernOnly == \"all\" or not(OSVersion startswith \"Windows 10\")\n| summarize Devices = dcount(DeviceName) by CUMonth, ClientState\n| order by CUMonth desc",
        "size": 0,
        "title": "Distribuzione ClientState per Mese CU",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "barchart",
        "chartSettings": {
          "xAxis": "CUMonth",
          "yAxis": [
            "Devices"
          ],
          "group": "ClientState",
          "seriesLabelSettings": [
            {
              "seriesName": "Installed",
              "color": "green"
            },
            {
              "seriesName": "Installing",
              "color": "blue"
            },
            {
              "seriesName": "Offering",
              "color": "orange"
            },
            {
              "seriesName": "OnHold",
              "color": "yellow"
            },
            {
              "seriesName": "Canceled",
              "color": "gray"
            },
            {
              "seriesName": "Unknown",
              "color": "redBright"
            }
          ]
        }
      },
      "name": "chart-state-by-month"
    },
    {
      "type": 1,
      "content": {
        "json": "## 📋 Dettaglio per Device - Stato Installazione"
      },
      "name": "text-section-detail"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let _kb = dynamic([{KBFilter}]);\nlet _clientState = dynamic([{ClientStateFilter}]);\nlet _classification = dynamic([{UpdateClassificationFilter}]);\nlet _cuMonth = dynamic([{CUMonthFilter}]);\nlet _osVersion = dynamic([{OSVersionFilter}]);\nlet _modernOnly = \"{ModernOnly}\";\nlet _deviceFilter = \"{DeviceNameFilter}\";\nlet clientInfo = UCClient\n| where TimeGenerated {TimeRange}\n| summarize arg_max(TimeGenerated, *) by AzureADDeviceId\n| project AzureADDeviceId, OSVersion, OSBuild, OSEdition, OSSecurityUpdateStatus, WUQualityDeferralDays, WUQualityPauseState, LastWUScanTime;\nUCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"WindowsQualityUpdate\"\n| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)\n| where \"*\" in (_kb) or TargetKBNumber in (_kb)\n| where \"*\" in (_classification) or UpdateClassification in (_classification)\n| where _deviceFilter == \"\" or DeviceName contains _deviceFilter\n| summarize arg_max(TimeGenerated, *) by DeviceName, TargetKBNumber\n| where \"*\" in (_clientState) or ClientState in (_clientState)\n| extend CUMonth = format_datetime(UpdateReleaseTime, \"yyyy-MM\")\n| where \"*\" in (_cuMonth) or CUMonth in (_cuMonth)\n| join kind=leftouter clientInfo on AzureADDeviceId\n| where \"*\" in (_osVersion) or OSVersion in (_osVersion)\n| where _modernOnly == \"all\" or not(OSVersion startswith \"Windows 10\")\n| project\n    CUMonth,\n    DeviceName,\n    TargetKBNumber,\n    UpdateDisplayName,\n    UpdateClassification,\n    ClientState,\n    ClientSubstate,\n    OSVersion,\n    OSBuild,\n    OSSecurityUpdateStatus,\n    WUQualityDeferralDays,\n    WUQualityPauseState,\n    LastWUScanTime,\n    ClientSubstateTime,\n    OfferReceivedTime,\n    RestartRequiredTime,\n    UpdateInstalledTime,\n    TimeGenerated\n| order by CUMonth desc, DeviceName asc, TargetKBNumber asc",
        "size": 0,
        "title": "Stato Installazione per Device e KB",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "ClientState",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Installed",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Installing",
                    "representation": "2",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Offering",
                    "representation": "warning",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "OnHold",
                    "representation": "4",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Canceled",
                    "representation": "cancelled",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Unknown",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "UpdateClassification",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Security",
                    "representation": "3",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "NonSecurity",
                    "representation": "1",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "OSSecurityUpdateStatus",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Latest",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "NotLatest",
                    "representation": "warning",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "MultipleSecurityUpdatesMissing",
                    "representation": "3",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "WUQualityPauseState",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "NotConfigured",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Paused",
                    "representation": "3",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "WUQualityDeferralDays",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "0",
                    "representation": "orange",
                    "text": "dato non disponibile"
                  },
                  {
                    "operator": "Default",
                    "representation": "blue",
                    "text": "{0}{1} days"
                  }
                ]
              }
            }
          ],
          "filter": true,
          "sortBy": [
            {
              "itemKey": "CUMonth",
              "sortOrder": 2
            }
          ]
        }
      },
      "name": "grid-device-detail"
    },
    {
      "type": 1,
      "content": {
        "json": "## 🚦 Stato e Alert per Device\n\nLa tabella mostra lo stato *lato device* (`ClientState` da `UCClientUpdateStatus`) e gli eventuali **alert** correlati alla stessa KB.\n\n**Note di lettura:**\n- La join con gli Alert avviene su `AzureADDeviceId` + `TargetBuild` in *leftouter*: vengono mostrate **tutte le cumulative** selezionate (anche con filtro *CU Month = All*); l'alert compare solo per le righe con un record corrispondente.\n- Quando il device è in attesa di riavvio per completare l'installazione viene mostrato `AwaitingRestart` nella colonna *Note*.\n- `AlertStatus = Resolved` indica un problema *passato già rientrato* (es. errore transitorio di connettività); non richiede azione."
      },
      "name": "text-section-service-alerts"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let _kb = dynamic([{KBFilter}]);\nlet _clientState = dynamic([{ClientStateFilter}]);\nlet _classification = dynamic([{UpdateClassificationFilter}]);\nlet _cuMonth = dynamic([{CUMonthFilter}]);\nlet _osVersion = dynamic([{OSVersionFilter}]);\nlet _modernOnly = \"{ModernOnly}\";\nlet _deviceFilter = \"{DeviceNameFilter}\";\nlet clientInfo = UCClient\n| where TimeGenerated {TimeRange}\n| summarize arg_max(TimeGenerated, *) by AzureADDeviceId\n| project AzureADDeviceId, OSVersion;\nlet updates = UCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"WindowsQualityUpdate\"\n| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)\n| where \"*\" in (_kb) or TargetKBNumber in (_kb)\n| where \"*\" in (_classification) or UpdateClassification in (_classification)\n| where _deviceFilter == \"\" or DeviceName contains _deviceFilter\n| summarize arg_max(TimeGenerated, *) by DeviceName, TargetKBNumber\n| where \"*\" in (_clientState) or ClientState in (_clientState)\n| extend CUMonth = format_datetime(UpdateReleaseTime, \"yyyy-MM\")\n| where \"*\" in (_cuMonth) or CUMonth in (_cuMonth)\n| join kind=leftouter clientInfo on AzureADDeviceId\n| where \"*\" in (_osVersion) or OSVersion in (_osVersion)\n| where _modernOnly == \"all\" or not(OSVersion startswith \"Windows 10\")\n| project DeviceName, AzureADDeviceId, TargetKBNumber, TargetBuild, CUMonth, ClientState, ClientSubstate;\nlet alertInfo = UCUpdateAlert\n| where TimeGenerated {TimeRange}\n| where isnotempty(TargetBuild)\n| summarize arg_max(TimeGenerated, *) by AzureADDeviceId, TargetBuild, AlertSubtype\n| project AzureADDeviceId, TargetBuild, AlertSubtype, AlertClassification, AlertStatus, ErrorCode;\nupdates\n| join kind=leftouter alertInfo on AzureADDeviceId, TargetBuild\n| extend Note = case(\n    ClientSubstate in (\"PendingRestart\", \"RestartRequired\", \"PendingReboot\"), \"AwaitingRestart\",\n    ClientState == \"Installed\" and isempty(AlertSubtype), \"OK - Installed\",\n    ClientState == \"Installing\" and isempty(AlertSubtype), strcat(\"In progress: \", ClientSubstate),\n    ClientState == \"Offering\" and isempty(AlertSubtype), \"Offered, not yet started\",\n    ClientState == \"OnHold\", \"On hold (safeguard/policy)\",\n    \"\"\n)\n| project\n    CUMonth,\n    DeviceName,\n    TargetKBNumber,\n    TargetBuild,\n    ClientState,\n    ClientSubstate,\n    AlertSubtype,\n    AlertClassification,\n    AlertStatus,\n    ErrorCode,\n    Note\n| order by CUMonth desc, DeviceName asc",
        "size": 0,
        "title": "Stato Service-Side e Alert attivi per Device/KB",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "AlertClassification",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Error",
                    "representation": "3",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Warning",
                    "representation": "warning",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "AlertStatus",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Active",
                    "representation": "3",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Resolved",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
