    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let _kb = dynamic([{DetailKBFilter:escape}]);\nlet _updateName = \"{DetailUpdateNameFilter:escape}\";\nlet _classification = dynamic([{DetailClassificationFilter:escape}]);\nlet _cuMonth = dynamic([{DetailCUMonthFilter:escape}]);\nlet _deviceFilter = \"{DetailDeviceNameFilter:escape}\";\nlet _clientState = dynamic([{DetailClientStateFilter:escape}]);\nlet _clientSubstate = dynamic([{DetailClientSubstateFilter:escape}]);\nlet _osVersion = dynamic([{DetailOSVersionFilter:escape}]);\nlet _osBuild = dynamic([{DetailOSBuildFilter:escape}]);\nlet _securityStatus = dynamic([{DetailOSSecurityStatusFilter:escape}]);\nlet _pauseState = dynamic([{DetailPauseStateFilter:escape}]);\nlet _modernOnly = \"{ModernOnly:escape}\";\nlet clientInfo = UCClient\n| summarize arg_max(TimeGenerated, OSVersion, OSBuild, OSSecurityUpdateStatus, WUQualityDeferralDays, WUQualityPauseState, LastWUScanTime) by AzureADDeviceId;\nUCClientUpdateStatus\n| where UpdateCategory == \"WindowsQualityUpdate\"\n| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)\n| summarize arg_max(TimeGenerated, DeviceName, UpdateDisplayName, UpdateClassification, ClientState, ClientSubstate, UpdateReleaseTime, ClientSubstateTime, OfferReceivedTime, RestartRequiredTime, UpdateInstalledTime) by AzureADDeviceId, TargetKBNumber\n| extend CUMonth = format_datetime(UpdateReleaseTime, \"yyyy-MM\")\n| where \"*\" in (_kb) or TargetKBNumber in (_kb)\n| where _updateName == \"\" or UpdateDisplayName contains _updateName\n| where \"*\" in (_classification) or UpdateClassification in (_classification)\n| where \"*\" in (_cuMonth) or CUMonth in (_cuMonth)\n| where _deviceFilter == \"\" or DeviceName contains _deviceFilter\n| where \"*\" in (_clientState) or ClientState in (_clientState)\n| where \"*\" in (_clientSubstate) or ClientSubstate in (_clientSubstate)\n| join kind=leftouter clientInfo on AzureADDeviceId\n| where \"*\" in (_osVersion) or OSVersion in (_osVersion)\n| where \"*\" in (_osBuild) or OSBuild in (_osBuild)\n| where \"*\" in (_securityStatus) or OSSecurityUpdateStatus in (_securityStatus)\n| where \"*\" in (_pauseState) or WUQualityPauseState in (_pauseState)\n| where _modernOnly == \"all\" or (OSVersion startswith \"Windows 11\" and (DeviceName startswith \"MP5\" or DeviceName startswith \"WP5\" or DeviceName startswith \"KP5\" or DeviceName startswith \"TP5\" or DeviceName startswith \"MS5\" or DeviceName startswith \"WS5\" or DeviceName startswith \"KS5\" or DeviceName startswith \"TS5\"))\n| project CUMonth, DeviceName, TargetKBNumber, UpdateDisplayName, UpdateClassification, ClientState, ClientSubstate, OSVersion, OSBuild, OSSecurityUpdateStatus, WUQualityDeferralDays, WUQualityPauseState, LastWUScanTime, ClientSubstateTime, OfferReceivedTime, RestartRequiredTime, UpdateInstalledTime, TimeGenerated\n| order by CUMonth desc, DeviceName asc, TargetKBNumber asc",
        "size": 0,
        "title": "Stato Installazione per Device e KB - Tutta la retention",
        "timeContext": {
          "durationMs": 0
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "ClientState",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Installed",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Installing",
                    "representation": "2",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Offering",
                    "representation": "warning",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "OnHold",
                    "representation": "4",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Canceled",
                    "representation": "cancelled",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Unknown",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "UpdateClassification",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Security",
                    "representation": "3",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "NonSecurity",
                    "representation": "1",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "OSSecurityUpdateStatus",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Latest",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "NotLatest",
                    "representation": "warning",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "MultipleSecurityUpdatesMissing",
                    "representation": "3",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "WUQualityPauseState",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "NotConfigured",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "NotPaused",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Paused",
                    "representation": "3",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "WUQualityDeferralDays",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "0",
                    "representation": "orange",
                    "text": "dato non disponibile"
                  },
                  {
                    "operator": "Default",
                    "representation": "blue",
                    "text": "{0}{1} days"
                  }
                ]
              }
            }
          ],
          "filter": true,
          "sortBy": [
            {
              "itemKey": "CUMonth",
              "sortOrder": 2
            }
          ]
        }
      },
      "name": "grid-device-detail"
    },
    {
      "type": 1,
      "content": {
        "json": "## 🚦 Stato Client e Alert per Device\n\nLa tabella mostra lo stato *lato device* (`ClientState` da `UCClientUpdateStatus`) e gli eventuali **alert** correlati alla stessa KB.\n\n**Note di lettura:**\n- La join con gli Alert avviene su `AzureADDeviceId` + `TargetBuild` in *leftouter*: vengono mostrate **tutte le cumulative** selezionate (anche con filtro *CU Month = All*); l'alert compare solo per le righe con un record corrispondente.\n- Quando il device è in attesa di riavvio per completare l'installazione viene mostrato `AwaitingRestart` nella colonna *Note*.\n- `AlertStatus = Resolved` indica un problema *passato già rientrato* (es. errore transitorio di connettività); non richiede azione.\n\n**Filtri locali:** KB, nome update, classificazione, CU Month, device, ClientState/ClientSubstate, OS Version, Alert Status/Classification/Subtype ed ErrorCode.\n- Con i filtri Alert impostati su *All* restano visibili anche le righe senza alert; selezionando valori specifici vengono mostrate solo le righe corrispondenti. In **Alert Status** è disponibile anche *(nessun alert)*."
      },
      "name": "text-section-service-alerts"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "f13d0001-0001-4001-8001-000000000001",
            "version": "KqlParameterItem/1.0",
            "name": "AlertKBFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "\"",
            "delimiter": ",",
            "query": "UCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"WindowsQualityUpdate\"\n| distinct TargetKBNumber\n| where isnotempty(TargetKBNumber)\n| order by TargetKBNumber desc",
            "timeContext": {
              "durationMs": 0
            },
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "value": [
              "value::all"
            ],
            "label": "KB Number"
          },
          {
            "id": "f13d0001-0002-4001-8001-000000000002",
            "version": "KqlParameterItem/1.0",
            "name": "AlertUpdateNameFilter",
            "type": 1,
            "isRequired": false,
            "value": "",
            "label": "Update Display Name (contains)"
          },
          {
            "id": "f13d0001-0003-4001-8001-000000000003",
            "version": "KqlParameterItem/1.0",
            "name": "AlertUpdateClassificationFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "\"",
            "delimiter": ",",
            "query": "let classifications = materialize(\n    UCClientUpdateStatus\n    | where TimeGenerated {TimeRange}\n| where UpdateCategory == \"WindowsQualityUpdate\"\n    | distinct UpdateClassification\n    | where isnotempty(UpdateClassification)\n);\nlet hasSecurity = toscalar(classifications | where UpdateClassification == \"Security\" | count) > 0;\nclassifications\n| project value = UpdateClassification, label = UpdateClassification, selected = iff(hasSecurity, UpdateClassification == \"Security\", true)\n| order by value asc",
            "timeContext": {
              "durationMs": 0
            },
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "label": "Classification (Security/NonSecurity)"
          },
          {
            "id": "f13d0001-0004-4001-8001-000000000004",
            "version": "KqlParameterItem/1.0",
            "name": "AlertCUMonthFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "\"",
            "delimiter": ",",
            "query": "UCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"WindowsQualityUpdate\"\n| where isnotempty(UpdateReleaseTime)\n| extend CUMonth = format_datetime(UpdateReleaseTime, \"yyyy-MM\")\n| distinct CUMonth\n| order by CUMonth desc",
            "timeContext": {
              "durationMs": 0
            },
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "value": [
              "value::all"
            ],
            "label": "CU Month"
          },
          {
            "id": "f13d0001-0005-4001-8001-000000000005",
            "version": "KqlParameterItem/1.0",
            "name": "AlertDeviceNameFilter",
            "type": 1,
            "isRequired": false,
            "value": "",
            "label": "Device Name (contains)"
          },
          {
            "id": "f13d0001-0006-4001-8001-000000000006",
            "version": "KqlParameterItem/1.0",
            "name": "AlertClientStateFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "\"",
            "delimiter": ",",
            "query": "UCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"WindowsQualityUpdate\"\n| distinct ClientState\n| where isnotempty(ClientState)\n| order by ClientState asc",
            "timeContext": {
              "durationMs": 0
            },
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "value": [
              "value::all"
            ],
            "label": "Client State"
          },
          {
            "id": "f13d0001-0007-4001-8001-000000000007",
            "version": "KqlParameterItem/1.0",
            "name": "AlertClientSubstateFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "\"",
            "delimiter": ",",
            "query": "UCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"WindowsQualityUpdate\"\n| distinct ClientSubstate\n| where isnotempty(ClientSubstate)\n| order by ClientSubstate asc",
            "timeContext": {
              "durationMs": 0
            },
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "value": [
              "value::all"
            ],
            "label": "Client Substate"
          },
          {
            "id": "f13d0001-0008-4001-8001-000000000008",
            "version": "KqlParameterItem/1.0",
            "name": "AlertOSVersionFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "\"",
            "delimiter": ",",
            "query": "UCClient\n| where TimeGenerated {TimeRange}\n| distinct OSVersion\n| where isnotempty(OSVersion)\n| order by OSVersion desc",
            "timeContext": {
              "durationMs": 0
            },
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "value": [
              "value::all"
            ],
            "label": "OS Version"
          },
          {
            "id": "f13d0001-0009-4001-8001-000000000009",
            "version": "KqlParameterItem/1.0",
            "name": "AlertStatusFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "\"",
            "delimiter": ",",
            "query": "UCUpdateAlert\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"WindowsQualityUpdate\"\n| where isnotempty(TargetBuild)\n| summarize arg_max(TimeGenerated, AlertStatus, AlertClassification) by AzureADDeviceId, TargetBuild, AlertSubtype\n| where AlertStatus != \"Deleted\"\n| distinct AlertStatus\n| where isnotempty(AlertStatus)\n| union (datatable(AlertStatus:string)[\"(nessun alert)\"])\n| order by AlertStatus asc",
            "timeContext": {
              "durationMs": 0
            },
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "value": [
              "value::all"
            ],
            "label": "Alert Status"
          },
          {
            "id": "f13d0001-0010-4001-8001-000000000010",
            "version": "KqlParameterItem/1.0",
            "name": "AlertClassificationFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "\"",
            "delimiter": ",",
            "query": "UCUpdateAlert\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"WindowsQualityUpdate\"\n| where isnotempty(TargetBuild)\n| summarize arg_max(TimeGenerated, AlertStatus, AlertClassification) by AzureADDeviceId, TargetBuild, AlertSubtype\n| where AlertStatus != \"Deleted\"\n| distinct AlertClassification\n| where isnotempty(AlertClassification)\n| order by AlertClassification asc",
            "timeContext": {
              "durationMs": 0
            },
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "value": [
              "value::all"
            ],
            "label": "Alert Classification"
          },
          {
            "id": "f13d0001-0011-4001-8001-000000000011",
            "version": "KqlParameterItem/1.0",
            "name": "AlertSubtypeFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "\"",
            "delimiter": ",",
            "query": "UCUpdateAlert\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"WindowsQualityUpdate\"\n| where isnotempty(TargetBuild)\n| summarize arg_max(TimeGenerated, AlertStatus, AlertClassification) by AzureADDeviceId, TargetBuild, AlertSubtype\n| where AlertStatus != \"Deleted\"\n| distinct AlertSubtype\n| where isnotempty(AlertSubtype)\n| order by AlertSubtype asc",
            "timeContext": {
              "durationMs": 0
            },
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "value": [
              "value::all"
            ],
            "label": "Alert Subtype"
          },
          {
            "id": "f13d0001-0012-4001-8001-000000000012",
            "version": "KqlParameterItem/1.0",
            "name": "AlertErrorCodeFilter",
            "type": 1,
            "isRequired": false,
            "value": "",
            "label": "Error Code (contains)"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "parameters-client-alerts"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let _kb = dynamic([{AlertKBFilter:escape}]);\nlet _updateName = \"{AlertUpdateNameFilter:escape}\";\nlet _classification = dynamic([{AlertUpdateClassificationFilter:escape}]);\nlet _cuMonth = dynamic([{AlertCUMonthFilter:escape}]);\nlet _deviceFilter = \"{AlertDeviceNameFilter:escape}\";\nlet _clientState = dynamic([{AlertClientStateFilter:escape}]);\nlet _clientSubstate = dynamic([{AlertClientSubstateFilter:escape}]);\nlet _osVersion = dynamic([{AlertOSVersionFilter:escape}]);\nlet _alertStatus = dynamic([{AlertStatusFilter:escape}]);\nlet _alertClassification = dynamic([{AlertClassificationFilter:escape}]);\nlet _alertSubtype = dynamic([{AlertSubtypeFilter:escape}]);\nlet _errorCode = \"{AlertErrorCodeFilter:escape}\";\nlet _modernOnly = \"{ModernOnly:escape}\";\nlet clientInfo = UCClient\n| where TimeGenerated {TimeRange}\n| summarize arg_max(TimeGenerated, OSVersion) by AzureADDeviceId;\nlet updates = UCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"WindowsQualityUpdate\"\n| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)\n| summarize arg_max(TimeGenerated, DeviceName, UpdateDisplayName, UpdateClassification, ClientState, ClientSubstate, UpdateReleaseTime, TargetBuild) by AzureADDeviceId, TargetKBNumber\n| extend CUMonth = format_datetime(UpdateReleaseTime, \"yyyy-MM\")\n| where \"*\" in (_kb) or TargetKBNumber in (_kb)\n| where _updateName == \"\" or UpdateDisplayName contains _updateName\n| where \"*\" in (_classification) or UpdateClassification in (_classification)\n| where \"*\" in (_cuMonth) or CUMonth in (_cuMonth)\n| where _deviceFilter == \"\" or DeviceName contains _deviceFilter\n| where \"*\" in (_clientState) or ClientState in (_clientState)\n| where \"*\" in (_clientSubstate) or ClientSubstate in (_clientSubstate)\n| join kind=leftouter clientInfo on AzureADDeviceId\n| where \"*\" in (_osVersion) or OSVersion in (_osVersion)\n| where _modernOnly == \"all\" or (OSVersion startswith \"Windows 11\" and (DeviceName startswith \"MP5\" or DeviceName startswith \"WP5\" or DeviceName startswith \"KP5\" or DeviceName startswith \"TP5\" or DeviceName startswith \"MS5\" or DeviceName startswith \"WS5\" or DeviceName startswith \"KS5\" or DeviceName startswith \"TS5\"))\n| project DeviceName, AzureADDeviceId, TargetKBNumber, TargetBuild, UpdateDisplayName, UpdateClassification, CUMonth, ClientState, ClientSubstate, OSVersion;\nlet alertInfo = UCUpdateAlert\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"WindowsQualityUpdate\"\n| where isnotempty(TargetBuild)\n| summarize arg_max(TimeGenerated, AlertStatus, AlertClassification, ErrorCode) by AzureADDeviceId, TargetBuild, AlertSubtype\n| where AlertStatus != \"Deleted\"\n| project AzureADDeviceId, TargetBuild, AlertSubtype, AlertClassification, AlertStatus, ErrorCode;\nupdates\n| join kind=leftouter alertInfo on AzureADDeviceId, TargetBuild\n| extend AlertFilterStatus = iff(isempty(AlertSubtype), \"(nessun alert)\", AlertStatus)\n| where \"*\" in (_alertStatus) or AlertFilterStatus in (_alertStatus)\n| where \"*\" in (_alertClassification) or AlertClassification in (_alertClassification)\n| where \"*\" in (_alertSubtype) or AlertSubtype in (_alertSubtype)\n| where _errorCode == \"\" or ErrorCode contains _errorCode\n| extend Note = case(ClientSubstate in (\"PendingRestart\", \"RestartRequired\", \"PendingReboot\"), \"AwaitingRestart\", ClientState == \"Installed\" and (isempty(AlertSubtype) or AlertStatus != \"Active\"), \"OK - Installed\", ClientState == \"Installing\" and (isempty(AlertSubtype) or AlertStatus != \"Active\"), strcat(\"In progress: \", ClientSubstate), ClientState == \"Offering\" and (isempty(AlertSubtype) or AlertStatus != \"Active\"), \"Offered, not yet started\", ClientState == \"OnHold\", \"On hold (safeguard/policy)\", \"\")\n| project CUMonth, DeviceName, TargetKBNumber, TargetBuild, UpdateDisplayName, UpdateClassification, OSVersion, ClientState, ClientSubstate, AlertSubtype, AlertClassification, AlertStatus, ErrorCode, Note\n| order by CUMonth desc, DeviceName asc",
        "size": 0,
        "title": "Stato Client e Alert per Device/KB",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "AlertClassification",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Error",
                    "representation": "3",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Warning",
                    "representation": "warning",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "AlertStatus",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Active",
                    "representation": "3",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Resolved",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "filter": true,
          "sortBy": [
            {
              "itemKey": "CUMonth",
              "sortOrder": 2
            }
          ]
        }
      },
      "name": "grid-client-alerts"
    },
    {
      "type": 1,
      "content": {
        "json": "---\n### Note\n- La colonna **CUMonth** è derivata da `UpdateReleaseTime` formattata come `yyyy-MM`\n- La vista **Dettaglio per Device - Stato Installazione** interroga tutta la retention interattiva; anche i suoi filtri locali usano lo stesso ambito\n- Gli altri pannelli e i relativi filtri locali rispettano **Intervallo Temporale**\n- **Tipo PC** resta globale; tutti gli altri filtri sono collocati nella vista che controllano"
      },
      "name": "text-footer"
    }
  ],
  "fallbackResourceIds": [],
