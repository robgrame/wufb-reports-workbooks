      "name": "parameters-driver-errors"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let _device = \"{ErrorDeviceNameFilter}\";\nlet _driver = \"{ErrorDriverNameFilter}\";\nlet _classification = dynamic([{ErrorUpdateClassificationFilter}]);\nlet _state = dynamic([{ErrorClientStateFilter}]);\nlet _substate = dynamic([{ErrorClientSubstateFilter}]);\nlet _alertClassification = dynamic([{ErrorAlertClassificationFilter}]);\nlet _alertSubtype = dynamic([{ErrorAlertSubtypeFilter}]);\nlet _error = \"{ErrorCodeFilter}\";\nlet _osVer = dynamic([{ErrorOSVersionFilter}]);\nlet _modernOnly = \"{ModernOnly}\";\nlet clientInfo = UCClient\n| where TimeGenerated {TimeRange}\n| summarize arg_max(TimeGenerated, OSVersion) by AzureADDeviceId\n| project AzureADDeviceId, OSVersion;\nlet updates = UCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"DriverUpdate\"\n| where isnotempty(UpdateId)\n| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)\n| summarize arg_max(TimeGenerated, DeviceName, UpdateDisplayName, UpdateClassification, TargetVersion, ClientState, ClientSubstate) by AzureADDeviceId, UpdateId\n| where _device == \"\" or DeviceName contains _device\n| where _driver == \"\" or UpdateDisplayName contains _driver\n| where \"*\" in (_classification) or UpdateClassification in (_classification)\n| where \"*\" in (_state) or ClientState in (_state)\n| where \"*\" in (_substate) or ClientSubstate in (_substate)\n| join kind=leftouter clientInfo on AzureADDeviceId\n| where \"*\" in (_osVer) or OSVersion in (_osVer)\n| where _modernOnly == \"all\" or (OSVersion startswith \"Windows 11\" and (DeviceName startswith \"MP5\" or DeviceName startswith \"WP5\" or DeviceName startswith \"KP5\" or DeviceName startswith \"TP5\" or DeviceName startswith \"MS5\" or DeviceName startswith \"WS5\" or DeviceName startswith \"KS5\" or DeviceName startswith \"TS5\"))\n| project DeviceName, AzureADDeviceId, UpdateDisplayName, UpdateClassification, UpdateId, TargetVersion, ClientState, ClientSubstate;\nlet alertInfo = UCUpdateAlert\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"DriverUpdate\"\n| where isnotempty(UpdateId)\n| summarize arg_max(TimeGenerated, AlertStatus, AlertClassification, ErrorCode, ErrorSymName, Recommendation, URL) by AzureADDeviceId, UpdateId, AlertSubtype\n| where AlertStatus == \"Active\"\n| project AzureADDeviceId, UpdateId, AlertSubtype, AlertClassification, AlertStatus, ErrorCode, ErrorSymName, Recommendation, URL;\nupdates\n| join kind=leftouter alertInfo on AzureADDeviceId, UpdateId\n| where ClientState == \"OnHold\" or isnotempty(AlertSubtype)\n| where \"*\" in (_alertClassification) or AlertClassification in (_alertClassification)\n| where \"*\" in (_alertSubtype) or AlertSubtype in (_alertSubtype)\n| where _error == \"\" or ErrorCode contains _error or ErrorSymName contains _error\n| extend URL = iff(isempty(URL) or URL startswith \"http\", URL, strcat(\"https://\", URL))\n| project DeviceName, UpdateDisplayName, UpdateClassification, TargetVersion, ClientState, ClientSubstate, AlertSubtype, AlertClassification, AlertStatus, ErrorCode, ErrorSymName, Recommendation, URL\n| order by DeviceName asc",
        "size": 0,
        "title": "Driver con errori o OnHold",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "ClientState",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "OnHold",
                    "representation": "4",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Canceled",
                    "representation": "cancelled",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "AlertClassification",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Error",
                    "representation": "3",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Warning",
                    "representation": "warning",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "URL",
              "formatter": 7,
              "formatOptions": {
                "linkTarget": "Url",
                "linkLabel": "KB / docs"
              }
            }
          ],
          "filter": true,
          "sortBy": [
            {
              "itemKey": "DeviceName",
              "sortOrder": 1
            }
          ]
        }
      },
      "name": "grid-driver-errors"
    },
