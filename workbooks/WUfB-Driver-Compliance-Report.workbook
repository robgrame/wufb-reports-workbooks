      "content": {
        "version": "KqlItem/1.0",
        "query": "let _device = \"{ServiceDeviceNameFilter}\";\nlet _driver = \"{ServiceDriverNameFilter}\";\nlet _state = dynamic([{ServiceClientStateFilter}]);\nlet _substate = dynamic([{ServiceClientSubstateFilter}]);\nlet _serviceState = dynamic([{ServiceStateFilter}]);\nlet _serviceSubstate = dynamic([{ServiceSubstateFilter}]);\nlet _alertStatus = dynamic([{ServiceAlertStatusFilter}]);\nlet _alertClassification = dynamic([{ServiceAlertClassificationFilter}]);\nlet _alertSubtype = dynamic([{ServiceAlertSubtypeFilter}]);\nlet _deployment = \"{ServiceDeploymentNameFilter}\";\nlet _policy = \"{ServicePolicyNameFilter}\";\nlet _osVer = dynamic([{ServiceOSVersionFilter}]);\nlet _modernOnly = \"{ModernOnly}\";\nlet clientInfo = UCClient\n| where TimeGenerated {TimeRange}\n| summarize arg_max(TimeGenerated, OSVersion) by AzureADDeviceId\n| project AzureADDeviceId, OSVersion;\nlet updates = UCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"DriverUpdate\"\n| where isnotempty(UpdateId)\n| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)\n| summarize arg_max(TimeGenerated, DeviceName, UpdateDisplayName, ClientState, ClientSubstate) by AzureADDeviceId, UpdateId\n| where _device == \"\" or DeviceName contains _device\n| where _driver == \"\" or UpdateDisplayName contains _driver\n| where \"*\" in (_state) or ClientState in (_state)\n| where \"*\" in (_substate) or ClientSubstate in (_substate)\n| join kind=leftouter clientInfo on AzureADDeviceId\n| where \"*\" in (_osVer) or OSVersion in (_osVer)\n| where _modernOnly == \"all\" or (OSVersion startswith \"Windows 11\" and (DeviceName startswith \"MP5\" or DeviceName startswith \"WP5\" or DeviceName startswith \"KP5\" or DeviceName startswith \"TP5\" or DeviceName startswith \"MS5\" or DeviceName startswith \"WS5\" or DeviceName startswith \"KS5\" or DeviceName startswith \"TS5\"))\n| project DeviceName, AzureADDeviceId, UpdateDisplayName, UpdateId, ClientState, ClientSubstate;\nlet serviceInfo = UCServiceUpdateStatus\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"DriverUpdate\"\n| where isnotempty(UpdateId)\n| summarize arg_max(TimeGenerated, ServiceState, ServiceSubstate, OfferReadyTime, DeploymentName, PolicyName) by AzureADDeviceId, UpdateId\n| project AzureADDeviceId, UpdateId, ServiceState, ServiceSubstate, OfferReadyTime, DeploymentName, PolicyName;\nlet alertInfo = UCUpdateAlert\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"DriverUpdate\"\n| where isnotempty(UpdateId)\n| summarize arg_max(TimeGenerated, AlertStatus, AlertClassification, ErrorCode) by AzureADDeviceId, UpdateId, AlertSubtype\n| where AlertStatus != \"Deleted\"\n| project AzureADDeviceId, UpdateId, AlertSubtype, AlertClassification, AlertStatus, ErrorCode;\nupdates\n| join kind=leftouter serviceInfo on AzureADDeviceId, UpdateId\n| join kind=leftouter alertInfo on AzureADDeviceId, UpdateId\n| where \"*\" in (_serviceState) or ServiceState in (_serviceState)\n| where \"*\" in (_serviceSubstate) or ServiceSubstate in (_serviceSubstate)\n| where \"*\" in (_alertStatus) or AlertStatus in (_alertStatus)\n| where \"*\" in (_alertClassification) or AlertClassification in (_alertClassification)\n| where \"*\" in (_alertSubtype) or AlertSubtype in (_alertSubtype)\n| where _deployment == \"\" or DeploymentName contains _deployment\n| where _policy == \"\" or PolicyName contains _policy\n| extend Note = case(ClientSubstate in (\"PendingRestart\", \"RestartRequired\", \"PendingReboot\"), \"AwaitingRestart\", ClientState == \"Installed\" and (isempty(AlertSubtype) or AlertStatus != \"Active\"), \"OK - Installed\", ClientState == \"Installing\" and (isempty(AlertSubtype) or AlertStatus != \"Active\"), strcat(\"In progress: \", ClientSubstate), ClientState == \"Offering\" and (isempty(AlertSubtype) or AlertStatus != \"Active\"), \"Offered, not yet started\", ClientState == \"OnHold\", \"On hold (safeguard/policy)\", \"\")\n| project DeviceName, UpdateDisplayName, ClientState, ClientSubstate, ServiceState, ServiceSubstate, DeploymentName, PolicyName, AlertSubtype, AlertClassification, AlertStatus, ErrorCode, Note\n| order by DeviceName asc",
        "size": 0,
        "title": "Stato Client e Alert per Device",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "ServiceState",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Offering",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Pending",
                    "representation": "pending",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "OnHold",
                    "representation": "4",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Canceled",
                    "representation": "cancelled",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "AlertClassification",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Error",
                    "representation": "3",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Warning",
                    "representation": "warning",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "AlertStatus",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Active",
                    "representation": "3",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Resolved",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "filter": true,
          "sortBy": [
            {
              "itemKey": "DeviceName",
              "sortOrder": 1
            }
          ]
        }
      },
      "name": "grid-driver-service-alerts"
    },
    {
      "type": 1,
      "content": {
        "json": "## 📦 Inventario Driver Installati\n\nFiltri locali per nome driver, UpdateClassification e OS Version. `TargetVersion` resta una dimensione di raggruppamento informativa quando popolata; la vista conta i device che hanno riportato un’installazione nella finestra selezionata."
      },
      "name": "text-section-inventory"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "e8a50001-0001-4001-8001-000000000001",
            "version": "KqlParameterItem/1.0",
            "name": "InventoryDriverNameFilter",
            "type": 1,
            "value": "",
            "label": "Nome Driver (contains)"
          },
          {
            "id": "e8a50001-0002-4001-8001-000000000002",
            "version": "KqlParameterItem/1.0",
            "name": "InventoryUpdateClassificationFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "UCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"DriverUpdate\"\n| where isnotempty(UpdateId)\n| summarize arg_max(TimeGenerated, UpdateClassification) by AzureADDeviceId, UpdateId\n| distinct UpdateClassification\n| where isnotempty(UpdateClassification)\n| order by UpdateClassification asc",
            "timeContext": {
              "durationMs": 0
            },
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "value": [
              "value::all"
            ],
            "label": "Update Classification"
          },
          {
            "id": "e8a50001-0004-4001-8001-000000000004",
            "version": "KqlParameterItem/1.0",
            "name": "InventoryOSVersionFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "UCClient\n| where TimeGenerated {TimeRange}\n| summarize arg_max(TimeGenerated, OSVersion) by AzureADDeviceId\n| distinct OSVersion\n| where isnotempty(OSVersion)\n| order by OSVersion desc",
            "timeContext": {
              "durationMs": 0
            },
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "value": [
              "value::all"
            ],
            "label": "OS Version"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "parameters-driver-inventory"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let _driver = \"{InventoryDriverNameFilter}\";\nlet _classification = dynamic([{InventoryUpdateClassificationFilter}]);\nlet _osVer = dynamic([{InventoryOSVersionFilter}]);\nlet _modernOnly = \"{ModernOnly}\";\nlet clientInfo = UCClient\n| where TimeGenerated {TimeRange}\n| summarize arg_max(TimeGenerated, OSVersion) by AzureADDeviceId\n| project AzureADDeviceId, OSVersion;\nUCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"DriverUpdate\"\n| where isnotempty(UpdateId)\n| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)\n| where ClientState == \"Installed\"\n| summarize arg_max(TimeGenerated, DeviceName, UpdateDisplayName, UpdateClassification, TargetVersion, UpdateInstalledTime) by AzureADDeviceId, UpdateId\n| where _driver == \"\" or UpdateDisplayName contains _driver\n| where \"*\" in (_classification) or UpdateClassification in (_classification)\n| join kind=leftouter clientInfo on AzureADDeviceId\n| where \"*\" in (_osVer) or OSVersion in (_osVer)\n| where _modernOnly == \"all\" or (OSVersion startswith \"Windows 11\" and (DeviceName startswith \"MP5\" or DeviceName startswith \"WP5\" or DeviceName startswith \"KP5\" or DeviceName startswith \"TP5\" or DeviceName startswith \"MS5\" or DeviceName startswith \"WS5\" or DeviceName startswith \"KS5\" or DeviceName startswith \"TS5\"))\n| summarize Installations = dcount(AzureADDeviceId), LastInstall = max(UpdateInstalledTime), FirstSeen = min(UpdateInstalledTime) by UpdateDisplayName, UpdateClassification, TargetVersion\n| order by Installations desc",
        "size": 0,
        "title": "Driver installati nella finestra selezionata",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Installations",
              "formatter": 4,
              "formatOptions": {
                "min": 0,
                "palette": "blue"
              }
            }
          ],
          "filter": true,
          "sortBy": [
            {
              "itemKey": "Installations",
              "sortOrder": 2
            }
          ]
        }
      },
      "name": "grid-driver-inventory"
    },
    {
      "type": 1,
      "content": {
        "json": "---\n### Note\n- I dati riflettono l'ultimo stato noto per AzureADDeviceId + UpdateId.\n- Gli errori sono ricostruiti tramite UCUpdateAlert.\n- Le correlazioni service/alert usano AzureADDeviceId + UpdateId.\n- PercentInstalledReported usa come denominatore solo i device che hanno riportato quello specifico driver."
      },
      "name": "text-footer"
    }
  ],
  "fallbackResourceIds": [],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json",
  "styleSettings": {},
  "fromTemplateId": "custom-wufb-driver-compliance"
}
