            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "UCUpdateAlert\n| where TimeGenerated {TimeRange}\n| where UpdateCategory == \"DriverUpdate\"\n| where isnotempty(UpdateId)\n| summarize arg_max(TimeGenerated, AlertStatus, AlertClassification) by AzureADDeviceId, UpdateId, AlertSubtype\n| where AlertStatus != \"Deleted\"\n| where AlertStatus == \"Active\"\n| distinct AlertClassification\n| where isnotempty(AlertClassification)\n| order by AlertClassification asc",
