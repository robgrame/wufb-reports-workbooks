{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# 📊 WUfB Reports - Stato Aggiornamento Device per KB\n\nQuesto workbook mostra lo stato di installazione degli aggiornamenti (KB) per ciascun device, basato sui dati di **Windows Update for Business Reports**.\n\n---"
      },
      "name": "text-header"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "a2b5e5e1-1111-4a1a-b1c1-d1e1f1a1b1c1",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "type": 4,
            "isRequired": true,
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 259200000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2592000000
                }
              ],
              "allowCustom": true
            },
            "value": {
              "durationMs": 604800000
            },
            "label": "Intervallo Temporale"
          },
          {
            "id": "a2b5e5e1-2222-4a1a-b1c1-d1e1f1a1b1c1",
            "version": "KqlParameterItem/1.0",
            "name": "UpdateCategoryFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "UCClientUpdateStatus\n| where TimeGenerated > ago(30d)\n| distinct UpdateCategory\n| order by UpdateCategory asc",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*"
            },
            "defaultValue": "value::all",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "label": "Categoria Update"
          },
          {
            "id": "a2b5e5e1-3333-4a1a-b1c1-d1e1f1a1b1c1",
            "version": "KqlParameterItem/1.0",
            "name": "ClientStateFilter",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "UCClientUpdateStatus\n| where TimeGenerated > ago(30d)\n| distinct ClientState\n| order by ClientState asc",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*"
            },
            "defaultValue": "value::all",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "label": "Stato Client"
          },
          {
            "id": "a2b5e5e1-4444-4a1a-b1c1-d1e1f1a1b1c1",
            "version": "KqlParameterItem/1.0",
            "name": "DeviceNameFilter",
            "type": 1,
            "isRequired": false,
            "value": "",
            "label": "Filtro Device Name (contiene)"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "parameters"
    },
    {
      "type": 1,
      "content": {
        "json": "## 📈 Riepilogo Stato Aggiornamenti"
      },
      "name": "text-summary-header"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let _updateCat = dynamic([{UpdateCategoryFilter}]);\nlet _clientState = dynamic([{ClientStateFilter}]);\nlet _deviceFilter = \"{DeviceNameFilter}\";\nUCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where \"*\" in (_updateCat) or UpdateCategory in (_updateCat)\n| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)\n| extend UpdateKey = coalesce(UpdateId, TargetKBNumber, strcat(UpdateDisplayName, \"|\", TargetBuild))\n| where _deviceFilter == \"\" or DeviceName contains _deviceFilter\n| summarize arg_max(TimeGenerated, *) by AzureADDeviceId, UpdateKey\n| where \"*\" in (_clientState) or ClientState in (_clientState)\n| summarize DeviceCount = dcount(AzureADDeviceId) by ClientState\n| order by DeviceCount desc",
        "size": 3,
        "title": "Distribuzione Device per Stato di Installazione",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "piechart",
        "chartSettings": {
          "seriesLabelSettings": [
            {
              "seriesName": "Installed",
              "color": "green"
            },
            {
              "seriesName": "Installing",
              "color": "blue"
            },
            {
              "seriesName": "Offering",
              "color": "orange"
            },
            {
              "seriesName": "OnHold",
              "color": "yellow"
            },
            {
              "seriesName": "Canceled",
              "color": "gray"
            },
            {
              "seriesName": "Unknown",
              "color": "redBright"
            }
          ]
        }
      },
      "name": "chart-clientstate-pie"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let _updateCat = dynamic([{UpdateCategoryFilter}]);\nlet _clientState = dynamic([{ClientStateFilter}]);\nlet _deviceFilter = \"{DeviceNameFilter}\";\nUCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where \"*\" in (_updateCat) or UpdateCategory in (_updateCat)\n| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)\n| extend UpdateKey = coalesce(UpdateId, TargetKBNumber, strcat(UpdateDisplayName, \"|\", TargetBuild))\n| where _deviceFilter == \"\" or DeviceName contains _deviceFilter\n| summarize arg_max(TimeGenerated, *) by AzureADDeviceId, UpdateKey\n| where \"*\" in (_clientState) or ClientState in (_clientState)\n| summarize DeviceCount = dcount(AzureADDeviceId) by ClientState, ClientSubstate\n| order by ClientState asc, DeviceCount desc",
        "size": 0,
        "title": "Dettaglio Device per ClientState e ClientSubstate",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "barchart",
        "chartSettings": {
          "xAxis": "ClientSubstate",
          "yAxis": [
            "DeviceCount"
          ],
          "group": "ClientState"
        }
      },
      "name": "chart-clientstate-substate-bar"
    },
    {
      "type": 1,
      "content": {
        "json": "## 📋 Dettaglio per KB - Stato Installazione per Device"
      },
      "name": "text-detail-header"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let _updateCat = dynamic([{UpdateCategoryFilter}]);\nlet _clientState = dynamic([{ClientStateFilter}]);\nlet _deviceFilter = \"{DeviceNameFilter}\";\nUCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where \"*\" in (_updateCat) or UpdateCategory in (_updateCat)\n| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)\n| extend UpdateKey = coalesce(UpdateId, TargetKBNumber, strcat(UpdateDisplayName, \"|\", TargetBuild))\n| where _deviceFilter == \"\" or DeviceName contains _deviceFilter\n| summarize arg_max(TimeGenerated, *) by AzureADDeviceId, UpdateKey\n| where \"*\" in (_clientState) or ClientState in (_clientState)\n| project\n    DeviceName,\n    TargetKBNumber,\n    UpdateDisplayName,\n    UpdateCategory,\n    UpdateClassification,\n    ClientState,\n    ClientSubstate,\n    ClientSubstateTime,\n    TargetBuild,\n    TargetVersion,\n    UpdateReleaseTime,\n    OfferReceivedTime,\n    RestartRequiredTime,\n    UpdateInstalledTime,\n    TimeGenerated\n| order by DeviceName asc, TargetKBNumber asc",
        "size": 0,
        "title": "Stato Aggiornamento per Device e KB",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "ClientState",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Installed",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Installing",
                    "representation": "2",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Offering",
                    "representation": "warning",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "OnHold",
                    "representation": "4",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Canceled",
                    "representation": "cancelled",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Unknown",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "filter": true,
          "sortBy": [
            {
              "itemKey": "DeviceName",
              "sortOrder": 1
            }
          ]
        }
      },
      "name": "grid-device-kb-status"
    },
    {
      "type": 1,
      "content": {
        "json": "## 🔍 Riepilogo per aggiornamento\n\nUsa una chiave composta con fallback UpdateId → TargetKBNumber → nome/build, così vengono mantenuti distinti driver, quality e feature update."
      },
      "name": "text-kb-summary-header"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let _updateCat = dynamic([{UpdateCategoryFilter}]);\nlet _clientState = dynamic([{ClientStateFilter}]);\nlet _deviceFilter = \"{DeviceNameFilter}\";\nUCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where \"*\" in (_updateCat) or UpdateCategory in (_updateCat)\n| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)\n| extend UpdateKey = coalesce(UpdateId, TargetKBNumber, strcat(UpdateDisplayName, \"|\", TargetBuild))\n| where _deviceFilter == \"\" or DeviceName contains _deviceFilter\n| summarize arg_max(TimeGenerated, *) by AzureADDeviceId, UpdateKey\n| where \"*\" in (_clientState) or ClientState in (_clientState)\n| summarize\n    ReportingDevices = dcount(AzureADDeviceId),\n    Installed = dcountif(AzureADDeviceId, ClientState == \"Installed\"),\n    Installing = dcountif(AzureADDeviceId, ClientState == \"Installing\"),\n    Offering = dcountif(AzureADDeviceId, ClientState == \"Offering\"),\n    OnHold = dcountif(AzureADDeviceId, ClientState == \"OnHold\"),\n    Canceled = dcountif(AzureADDeviceId, ClientState == \"Canceled\"),\n    Unknown = dcountif(AzureADDeviceId, ClientState == \"Unknown\")\n    by UpdateKey, TargetKBNumber, UpdateDisplayName, UpdateCategory, UpdateClassification\n| extend PercentInstalledReported = round(todouble(Installed) / todouble(ReportingDevices) * 100, 1)\n| order by TargetKBNumber desc",
        "size": 0,
        "title": "Riepilogo compliance per update tra device con stato riportato",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "PercentInstalledReported",
              "formatter": 8,
              "formatOptions": {
                "min": 0,
                "max": 100,
                "palette": "redGreen"
              }
            },
            {
              "columnMatch": "Installed",
              "formatter": 8,
              "formatOptions": {
                "palette": "green"
              }
            }
          ],
          "filter": true,
          "sortBy": [
            {
              "itemKey": "PercentInstalledReported",
              "sortOrder": 2
            }
          ]
        }
      },
      "name": "grid-kb-compliance-summary"
    },
    {
      "type": 1,
      "content": {
        "json": "## ⚠️ Device con Aggiornamenti in Stato Problematico"
      },
      "name": "text-problem-header"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let _updateCat = dynamic([{UpdateCategoryFilter}]);\nlet _deviceFilter = \"{DeviceNameFilter}\";\nUCClientUpdateStatus\n| where TimeGenerated {TimeRange}\n| where \"*\" in (_updateCat) or UpdateCategory in (_updateCat)\n| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)\n| extend UpdateKey = coalesce(UpdateId, TargetKBNumber, strcat(UpdateDisplayName, \"|\", TargetBuild))\n| where _deviceFilter == \"\" or DeviceName contains _deviceFilter\n| summarize arg_max(TimeGenerated, *) by AzureADDeviceId, UpdateKey\n| where ClientState in (\"OnHold\", \"Canceled\", \"Unknown\") or ClientSubstate in (\"Validation\", \"SafeguardHold\")\n| project\n    DeviceName,\n    TargetKBNumber,\n    UpdateDisplayName,\n    UpdateCategory,\n    ClientState,\n    ClientSubstate,\n    ClientSubstateTime,\n    TimeGenerated\n| order by ClientState asc, DeviceName asc",
        "size": 0,
        "title": "Device con Update Bloccati o Problematici",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "ClientState",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "OnHold",
                    "representation": "4",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Canceled",
                    "representation": "cancelled",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Unknown",
                    "representation": "unknown",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "representation": "warning",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "filter": true
        }
      },
      "name": "grid-problem-devices"
    },
    {
      "type": 1,
      "content": {
        "json": "---\n### Legenda Stati (da [WUfB Reports Schema](https://learn.microsoft.com/en-us/windows/deployment/update/wufb-reports-schema-enumerated-types))\n\n| ClientState | Descrizione |\n|---|---|\n| **Unknown** | Default, nessun dato client disponibile |\n| **Offering** | L'update è stato offerto al device |\n| **Installing** | L'installazione è in corso |\n| **Installed** | L'update è stato installato |\n| **Uninstalling** | L'update è in fase di disinstallazione |\n| **Uninstalled** | L'update è stato disinstallato |\n| **Canceled** | L'update è stato annullato |\n| **OnHold** | L'update è in attesa/sospeso |"
      },
      "name": "text-legend"
    }
  ],
  "fallbackResourceIds": [],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json",
  "styleSettings": {},
  "fromTemplateId": "custom-wufb-device-update-status"
}
