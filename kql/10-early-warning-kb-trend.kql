// Early Warning Dashboard - daily success/failure trend per KB
// Useful for spotting a worsening failure rate on a specific KB in the days
// following its release (early warning on a bad update).
UCClientUpdateStatus
| where TimeGenerated > ago(30d)
| where UpdateCategory == "WindowsQualityUpdate"
| summarize arg_max(TimeGenerated, ClientState) by AzureADDeviceId, TargetKBNumber, bin(TimeGenerated, 1d)
| summarize
    Installed = countif(ClientState == "Installed"),
    Failed = countif(ClientState in ("OnHold", "Canceled")),
    Installing = countif(ClientState == "Installing"),
    Total = count()
    by Day = bin(TimeGenerated, 1d), TargetKBNumber
| extend
    SuccessRatePercent = round(100.0 * Installed / Total, 1),
    FailureRatePercent = round(100.0 * Failed / Total, 1)
| sort by TargetKBNumber desc, Day asc

// Workbook suggestion: line chart (Day on X axis, FailureRatePercent on Y,
// one series per TargetKBNumber) with a conditional red threshold above a
// configurable %.
