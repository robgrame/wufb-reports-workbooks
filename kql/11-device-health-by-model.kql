// Device Health Correlation - update failures by hardware model
// NOTE: UCClient.DeviceManufacturer and UCClient.DeviceModel are documented
// by Microsoft as "currently not gathered" (not populated) in the WUfB
// Reports schema. To correlate failures with the device model you need to
// join with the Intune device inventory (custom table exported via Graph
// "managedDevices", e.g. IntuneDevices) on AzureADDeviceId.
// If the IntuneDevices table does not exist in the workspace, it must be
// created via an Intune diagnostic export or a custom connector (Logic
// App/Function that writes Graph data into a custom Log Analytics table).
UCClientUpdateStatus
| where TimeGenerated > ago(30d)
| where ClientState in ("OnHold", "Canceled", "Unknown")
| summarize arg_max(TimeGenerated, *) by AzureADDeviceId, TargetKBNumber
| join kind=inner (
    IntuneDevices
    | summarize arg_max(TimeGenerated, *) by AzureADDeviceId
    | project AzureADDeviceId, Model, Manufacturer
) on AzureADDeviceId
| summarize
    FailedDevices = dcount(AzureADDeviceId),
    FailedInstalls = count()
    by Model, Manufacturer, TargetKBNumber
| sort by FailedDevices desc
