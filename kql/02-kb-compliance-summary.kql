// Riepilogo Compliance per KB
// Quanti device hanno installato / stanno installando ogni KB
UCClientUpdateStatus
| where TimeGenerated > ago(7d)
| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)
| extend UpdateKey = coalesce(UpdateId, TargetKBNumber, strcat(UpdateDisplayName, "|", TargetBuild))
| summarize arg_max(TimeGenerated, *) by AzureADDeviceId, UpdateKey
| summarize
    ReportingDevices = dcount(AzureADDeviceId),
    Installed = dcountif(AzureADDeviceId, ClientState == "Installed"),
    Installing = dcountif(AzureADDeviceId, ClientState == "Installing"),
    Offering = dcountif(AzureADDeviceId, ClientState == "Offering"),
    OnHold = dcountif(AzureADDeviceId, ClientState == "OnHold"),
    Canceled = dcountif(AzureADDeviceId, ClientState == "Canceled"),
    Unknown = dcountif(AzureADDeviceId, ClientState == "Unknown")
    by UpdateKey, TargetKBNumber, UpdateDisplayName, UpdateCategory, UpdateClassification
| extend PercentInstalledReported = round(todouble(Installed) / todouble(ReportingDevices) * 100, 1)
| sort by TargetKBNumber desc
