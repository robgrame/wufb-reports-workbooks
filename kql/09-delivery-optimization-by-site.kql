// Delivery Optimization efficiency by site
// UCDOStatus has no native "Site/Subnet" field. The site is derived from the
// hostname prefix (adjust the extract() regex to match your own naming
// convention). For a real subnet/site mapping, join with a custom table
// (e.g. SiteSubnetMap) loaded into the workspace instead.
UCDOStatus
| where TimeGenerated > ago(7d)
| summarize arg_max(TimeGenerated, *) by AzureADDeviceId, ContentType
| extend Site = extract(@"^([A-Za-z]{2,4}\d?)-", 1, DeviceName)
| extend Site = iff(isempty(Site), "Unknown", Site)
| summarize
    Devices = dcount(AzureADDeviceId),
    AvgBWOptPercent7Days = round(avg(BWOptPercent7Days), 1),
    AvgBWOptPercent28Days = round(avg(BWOptPercent28Days), 1),
    TotalBytesFromCache = sum(BytesFromCache),
    TotalBytesFromCDN = sum(BytesFromCDN),
    TotalBytesFromPeers = sum(BytesFromPeers)
    by Site, Country, City
| extend EfficiencyPercent = round(
    100.0 * TotalBytesFromCache / (TotalBytesFromCache + TotalBytesFromCDN + 1), 1)
| sort by Devices desc
