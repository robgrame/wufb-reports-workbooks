// Stato aggiornamento per Device e KB (dettaglio completo)
// Mostra l'ultimo stato di ciascun device per ogni KB target
UCClientUpdateStatus
| where TimeGenerated > ago(7d)
| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)
| extend UpdateKey = coalesce(UpdateId, TargetKBNumber, strcat(UpdateDisplayName, "|", TargetBuild))
| summarize arg_max(TimeGenerated, *) by AzureADDeviceId, UpdateKey
| project
    DeviceName,
    TargetKBNumber,
    UpdateDisplayName,
    UpdateCategory,
    UpdateClassification,
    ClientState,
    ClientSubstate,
    ClientSubstateTime,
    TargetBuild,
    TargetVersion,
    UpdateReleaseTime,
    OfferReceivedTime,
    RestartRequiredTime,
    UpdateInstalledTime,
    TimeGenerated
| sort by DeviceName asc, TargetKBNumber asc
