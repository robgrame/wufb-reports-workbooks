// Device bloccati o in stato problematico
// OnHold, Canceled, Unknown, SafeguardHold, Validation
UCClientUpdateStatus
| where TimeGenerated > ago(7d)
| extend DeviceName = iff(isempty(DeviceName), AzureADDeviceId, DeviceName)
| extend UpdateKey = coalesce(UpdateId, TargetKBNumber, strcat(UpdateDisplayName, "|", TargetBuild))
| summarize arg_max(TimeGenerated, *) by AzureADDeviceId, UpdateKey
| where ClientState in ("OnHold", "Canceled", "Unknown")
    or ClientSubstate in ("Validation", "SafeguardHold")
| project
    DeviceName,
    TargetKBNumber,
    UpdateDisplayName,
    ClientState,
    ClientSubstate,
    ClientSubstateTime,
    TimeGenerated
| sort by ClientState asc, DeviceName asc
