// Country/Branch Heatmap - compliance by country
// UCClient.Country is populated (IP-based geolocation). Use it as the
// "location" layer in the Azure Monitor workbook Map visual: geographic
// resolution by country code/name is native, no custom lat/long needed.
UCClient
| where TimeGenerated > ago(7d)
| summarize arg_max(TimeGenerated, *) by AzureADDeviceId
| summarize
    Devices = dcount(AzureADDeviceId),
    NotLatestSecurity = countif(OSSecurityUpdateStatus == "NotLatest"),
    MultipleMissing = countif(OSSecurityUpdateStatus == "MultipleSecurityUpdatesMissing"),
    FeatureNotLatest = countif(OSFeatureUpdateStatus == "EndOfService")
    by Country
| extend ComplianceGapPercent = round(100.0 * (NotLatestSecurity + MultipleMissing) / Devices, 1)
| sort by ComplianceGapPercent desc

// Note: UCClient.City is not populated by Microsoft (documented as
// "currently not gathered"). For a City/branch breakdown use UCDOStatus
// (City is populated there) or a custom country/branch mapping table.
