// Country/Branch Heatmap - compliance per country
// UCClient.Country e' popolato (geolocalizzazione da IP). Da usare come
// layer "location" nel visual Map dei workbook Azure Monitor: la risoluzione
// geografica per country code/nome e' nativa, senza bisogno di lat/long custom.
UCClient
| where TimeGenerated > ago(7d)
| summarize arg_max(TimeGenerated, *) by AzureADDeviceId
| summarize
    Devices = dcount(AzureADDeviceId),
    NotLatestSecurity = countif(OSSecurityUpdateStatus == "NotLatest"),
    MultipleMissing = countif(OSSecurityUpdateStatus == "MultipleSecurityUpdatesMissing"),
    FeatureNotLatest = countif(OSFeatureUpdateStatus == "EndOfService")
    by Country
| extend ComplianceGapPercent = round(100.0 * (NotLatestSecurity + MultipleMissing) / Devices, 1)
| sort by ComplianceGapPercent desc

// Nota: UCClient.City non e' popolato da Microsoft (documentato come
// "currently not gathered"). Per breakdown per City/branch usare UCDOStatus
// (City e' popolato li') o una tabella custom di mapping country/branch.
