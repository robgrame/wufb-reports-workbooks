// Alert: new error codes appearing across multiple devices
// UCUpdateAlert.ErrorCode is populated (unlike UCDeviceAlert.ErrorCode,
// which Microsoft does not yet collect). Flags error codes active on at
// least N distinct devices in the last 24 hours, useful for detecting a
// systemic issue (e.g. a bad driver or a KB with widespread incompatibility).
let MinDevices = 5;
UCUpdateAlert
| where StartTime > ago(1d)
| where AlertStatus == "Active"
| where isnotempty(ErrorCode)
| summarize
    Devices = dcount(AzureADDeviceId),
    SampleDevices = make_set(DeviceName, 5)
    by ErrorCode, ErrorSymName, AlertClassification, UpdateCategory
| where Devices >= MinDevices
| sort by Devices desc

// Suggested alert rule:
//   Measurement: Table rows
//   Threshold: Greater than 0
//   Evaluation frequency: 1h, Period: 1d
